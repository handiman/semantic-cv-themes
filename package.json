{
  "name": "semantic-cv-themes",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:themeRegistry && tsc --project tsconfig.json",
    "build:themeRegistry": "node scripts/generate-themeRegistry.js ./",
    "test": "npm run build && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml ./**/*.test.js",
    "test:update-snapshots": "npm run build && node test/snapshot.test.js --update",
    "new-theme": "node scripts/new-theme.mjs",
    "preview": "npm run build && node scripts/preview.mjs"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "imports": {
    "#themes/*": "./dist/*"
  }
}
